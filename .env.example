# Copy to .env and fill in. Real values never go in git (constitution, principle V).
# All keys are optional for a local demo: every integration has a fake or fallback.

DATABASE_URL=postgresql://crossroads:crossroads@db:5432/crossroads
POSTGRES_USER=crossroads
POSTGRES_PASSWORD=crossroads
POSTGRES_DB=crossroads

NESSIE_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Staff login for the internal dashboard. Sign-in stays off until all three are set.
# Make the hash with `python -m crossroads.internal_api.auth hash` (it asks for the password at a hidden
# prompt and prints only the hash). Paste it in SINGLE quotes: an argon2 hash contains `$`, which Docker
# Compose would otherwise treat as a variable. Never write the password itself in this file.
#   STAFF_PASSWORD_HASH='$argon2id$v=19$...'
# SESSION_SECRET signs the session cookie: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_USER=staff
STAFF_PASSWORD_HASH=
SESSION_SECRET=
# true when the dashboard is served over https (production), so the cookie is sent only over https.
COOKIE_SECURE=false

# Production hostnames: app.<APP_DOMAIN> and internal.<APP_DOMAIN>
APP_DOMAIN=
