# Copy to .env and fill in. Real values never go in git (constitution, principle V).
# All keys are optional for a local demo: every integration has a fake or fallback.

DATABASE_URL=postgresql://crossroads:crossroads@db:5432/crossroads
POSTGRES_USER=crossroads
POSTGRES_PASSWORD=crossroads
POSTGRES_DB=crossroads

NESSIE_API_KEY=
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# Staff login for the internal dashboard. Generate the hash with:
#   python -m crossroads.internal_api.auth hash
STAFF_USER=staff
STAFF_PASSWORD_HASH=
SESSION_SECRET=change-me

# Production hostnames: app.<APP_DOMAIN> and internal.<APP_DOMAIN>
APP_DOMAIN=
